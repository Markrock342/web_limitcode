{
  "name": "web__limitcode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "find .next -name '._*' -delete 2>/dev/null; next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "playwright test --config=playwright.api.config.ts",
    "test:e2e": "npm run build && playwright test --project=chromium --project=mobile-chromium",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm audit --audit-level=high"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.17.0",
    "motion": "^13.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "puppeteer": "^25.16.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
